#!/usr/bin/env bash

set -euo pipefail

CLIPBOARD="$HOME/.cache/zellij-clipboard.txt"

if [[ $# -ne 1 ]]; then
    echo "Usage: zpaste terminal_PANE_ID"
    exit 1
fi

if [[ ! "$1" =~ ^terminal_[0-9]+$ ]]; then
    echo "Invalid pane ID. Example: terminal_3"
    exit 1
fi

if [[ ! -s "$CLIPBOARD" ]]; then
    echo "Clipboard is empty."
    exit 1
fi

if [[ -z "${ZELLIJ:-}" ]]; then
    echo "Not running inside Zellij."
    exit 1
fi

zellij action paste \
    --pane-id "$1" \
    -- \
    "$(cat "$CLIPBOARD")"
